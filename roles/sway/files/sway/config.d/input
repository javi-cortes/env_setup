# keyboard layout set to spaniard
input * xkb_layout es

# Enable num lock by default
input 6940:6985:Corsair_CORSAIR_K70_RGB_MK.2_Mechanical_Gaming_Keyboard xkb_numlock enabled

input {
  type:touchpad {
    tap enabled
    middle_emulation enabled
    dwt disabled
  }
}

input "1386:890:Wacom_One_by_Wacom_S_Pen" {
    map_to_region 0 0 1920 1080
}